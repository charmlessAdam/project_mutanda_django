# Environment variables for production deployment
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-to-something-secure
ALLOWED_HOSTS=*.lightsail.aws.amazon.com,your-static-ip-here

# Database configuration (AWS RDS)
DATABASE_NAME=project-mutabda-db
DATABASE_USER=your-db-username
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=your-db-hostname
DATABASE_PORT=5432

# CORS settings (update with your Amplify URL)
CORS_ALLOWED_ORIGINS=https://agricore.nabutest.com,https://www.agricore.nabutest.com,https://master.dgpa1aqn4ppz.amplifyapp.com

# Security settings (production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True


# CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://agricore.nabutest.com,https://www.agricore.nabutest.com,https://master.dgpa1aqn4ppz.amplifyapp.com

# JWT cookie auth settings
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None
JWT_COOKIE_DOMAIN=

